    <ProjectReference Include="..\..\src\U2BIO.BT003PROLabelPrinting\U2BIO.BT003PROLabelPrinting.csproj">
      <Project>{8815635E-D90E-460C-A732-7161E758FCA5}</Project>
      <Name>U2BIO.BT003PROLabelPrinting</Name>
      <AdditionalProperties>Platform=AnyCPU</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="CheckPlatform" BeforeTargets="BeforeBuild">
    <Error Condition="'$(Platform)' != 'x86' And '$(Platform)' != 'x64'" Text="OfflineSmoke requires x86 or x64." />
  </Target>
</Project>
